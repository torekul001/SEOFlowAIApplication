# Configuration reference only: ASP.NET Core does not automatically load .env files.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ConnectionStrings__SeoFlow=Server=YOUR_SQL_HOST;Database=SEOFlowAI;User Id=seoflow_app;Password=REPLACE;Encrypt=True;TrustServerCertificate=False;
Auth__SigningKey=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
Auth__Issuer=SEOFlowAI
Auth__Audience=SEOFlowAI
Auth__RequireVerifiedEmail=true
Mail__Host=
Mail__Port=587
Mail__From=
Mail__Username=
Mail__Password=
SEOFLOW_BOOTSTRAP_SECRET=
SEOFLOW_ADMIN_EMAIL=
SEOFLOW_TEST_SQL=
