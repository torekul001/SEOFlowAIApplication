@model DashboardModel
@{ ViewData["Title"] = "Agency dashboard"; }
<p class="eyebrow">AGENCY OVERVIEW</p><h1>Your search workspace.</h1><p class="muted">A clear view of your organizations, people, and website portfolio.</p>
<div class="toolbar"><form method="get"><label for="tenantId">Organization</label><select id="tenantId" name="tenantId">@foreach(var tenant in Model.Tenants){<option value="@tenant.Id" selected="@(tenant.Id == Model.SelectedTenant)">@tenant.Name · @tenant.Role</option>}</select><button class="secondary">Switch workspace</button></form></div>
@if(Model.Dashboard is not null){
<div class="metrics"><article><p>Active organization</p><h2>@Model.Dashboard.TenantName</h2></article><article><p>Websites</p><strong>@Model.Dashboard.Websites</strong></article><article><p>Active members</p><strong>@Model.Dashboard.Members</strong></article><article><p>SEO providers</p><h2>@Model.Dashboard.Integrations</h2><small>Connectors arrive in Phase 4</small></article></div>
<section class="panel"><div class="section-head"><div><h2>Website portfolio</h2><p>Domains are unverified until ownership verification is implemented.</p></div><span class="badge">@Model.Websites!.Total sites</span></div>
<form method="get" class="search"><input type="hidden" name="tenantId" value="@Model.SelectedTenant"/><label for="search">Find a website</label><input id="search" name="search" value="@Context.Request.Query["search"]"/><button class="secondary">Search</button></form>
@if(Model.Websites.Items.Count == 0){<div class="empty"><h3>No websites found</h3><p>Add your first domain to start building your portfolio. SEO metrics will appear after real integrations are connected.</p></div>}else{<div class="table-wrap"><table><caption class="sr-only">Websites in the selected organization</caption><thead><tr><th>Name</th><th>Domain</th><th>Ownership</th></tr></thead><tbody>@foreach(var site in Model.Websites.Items){<tr><td>@site.Name</td><td>@site.BaseUrl</td><td><span class="badge">@(site.IsVerified ? "Verified" : "Not verified")</span></td></tr>}</tbody></table></div>}
<nav aria-label="Website pages">@if(Model.Websites.Page > 1){<a asp-route-tenantId="@Model.SelectedTenant" asp-route-page="@(Model.Websites.Page - 1)" asp-route-search="@Context.Request.Query["search"]">Previous</a>}<span>Page @Model.Websites.Page</span>@if(Model.Websites.Page * Model.Websites.PageSize < Model.Websites.Total){<a asp-route-tenantId="@Model.SelectedTenant" asp-route-page="@(Model.Websites.Page + 1)" asp-route-search="@Context.Request.Query["search"]">Next</a>}</nav>
</section>
var role = Model.Tenants.Single(x => x.Id == Model.SelectedTenant).Role;
@if(SEOFlow.Domain.TenantPolicy.CanWriteWebsite(role)){<section class="panel"><h2>Add a website</h2><form asp-action="AddWebsite" method="post" class="grid-form"><input type="hidden" name="tenantId" value="@Model.SelectedTenant"/><div><label for="siteName">Website name</label><input id="siteName" name="Name" maxlength="160" required/></div><div><label for="domain">HTTPS domain</label><input id="domain" name="Domain" placeholder="https://example.com" required/></div><button>Add website</button></form></section>}
@if(SEOFlow.Domain.TenantPolicy.CanManage(role)){<section class="panel"><h2>Invite a team member</h2><form asp-action="Invite" method="post" class="grid-form"><input type="hidden" name="tenantId" value="@Model.SelectedTenant"/><div><label for="inviteEmail">Email</label><input id="inviteEmail" type="email" name="Email" required/></div><div><label for="role">Role</label><select id="role" name="Role">@foreach(var name in SEOFlow.Domain.TenantPolicy.Roles.Where(x => x != "SuperAdmin")){<option>@name</option>}</select></div><button>Create invitation</button></form></section>}
}else{<section class="panel empty"><h2>No organizations yet</h2><p>Create an organization or accept an invitation below.</p></section>}
<div class="columns"><section class="panel"><h2>Create an organization</h2><form asp-action="CreateTenant" method="post"><label for="organization">Organization name</label><input id="organization" name="Name" maxlength="160" required/><button>Create organization</button></form></section><section class="panel"><h2>Join an organization</h2><form asp-action="Accept" method="post"><label for="invitation">Invitation token</label><input id="invitation" name="Token" required/><button class="secondary">Accept invitation</button></form></section></div>
