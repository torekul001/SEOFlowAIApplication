<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · SEOFlow AI</title><link rel="stylesheet" href="~/css/site.css"/></head>
<body><a class="skip" href="#main">Skip to content</a><header><a class="brand" asp-controller="Dashboard" asp-action="Index">◈ SEOFlow <span>AI</span></a><nav aria-label="Account">@if(User.Identity?.IsAuthenticated == true){<span>@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="secondary">Sign out</button></form>}else{<a asp-controller="Account" asp-action="Login">Sign in</a><a asp-controller="Account" asp-action="Register">Create account</a>}</nav></header>
<main id="main">@if(TempData["Message"] is string message){<div class="notice" role="status">@message</div>}@RenderBody()</main><footer>SEOFlow AI · Phase 1 foundation · UTC storage · Read-only SEO operations</footer></body></html>
