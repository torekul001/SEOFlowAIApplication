@model RegisterRequest
@{ ViewData["Title"] = "Create account"; }
<section class="auth"><p class="eyebrow">START YOUR WORKSPACE</p><h1>Build better search visibility.</h1><form method="post"><div asp-validation-summary="All" role="alert"></div><label asp-for="Organization"></label><input asp-for="Organization" maxlength="160" required/><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="username" required/><label asp-for="Password">Password (12–128 characters)</label><input asp-for="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required/><button>Create account</button></form></section>
