@model PasswordResetRequest
@{ ViewData["Title"] = "Choose a new password"; }
<section class="auth"><h1>Choose a new password</h1><form method="post"><div asp-validation-summary="All" role="alert"></div><label asp-for="Token"></label><input asp-for="Token" type="text" required/><label asp-for="Password"></label><input asp-for="Password" type="password" required/><button>Continue</button></form></section>
